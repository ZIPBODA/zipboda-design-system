{
  "name": "@zipboda/ui-core",
  "version": "1.3.1",
  "description": "집보다(Zipboda) UI 계약 — 프레임워크 무관 타입·variant→token 맵 (DOM/RN 파리티)",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZIPBODA/zipboda-design-system.git",
    "directory": "packages/ui-core"
  }
}
