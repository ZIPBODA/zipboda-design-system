{
  "name": "@zipboda/ui",
  "version": "1.0.0",
  "description": "집보다(Zipboda) React DOM UI 컴포넌트 (web·admin 공유)",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external react --external react-dom --clean",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@zipboda/tokens": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@zipboda/tokens": {
      "optional": false
    }
  },
  "dependencies": {
    "@zipboda/ui-core": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZIPBODA/zipboda-design-system.git",
    "directory": "packages/ui"
  }
}
