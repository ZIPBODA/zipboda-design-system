{
  "name": "@zipboda/tokens",
  "version": "1.2.0",
  "description": "집보다(Zipboda) 디자인 토큰 — DTCG 소스 → Style Dictionary (CSS 변수·ES6/TS·RN)",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "build",
    "src",
    "tailwind-preset.cjs"
  ],
  "exports": {
    ".": {
      "types": "./build/js/index.d.ts",
      "import": "./build/js/index.js"
    },
    "./css": "./build/css/variables.css",
    "./tokens.css": "./build/css/variables.css",
    "./tailwind": "./tailwind-preset.cjs"
  },
  "scripts": {
    "build": "style-dictionary build --config style-dictionary.config.mjs",
    "prepack": "pnpm build",
    "clean": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "style-dictionary": "^4.3.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZIPBODA/zipboda-design-system.git",
    "directory": "packages/tokens"
  }
}
